# ============================================================
#  ATLAS 需求规范化 · 联网 AI 配置
#
#  在下面填好 API Key 与接口地址并保存，刷新页面即切换为「联网 AI」。
#  不需要重启服务，不需要改代码。
#  全部留空 = 使用本地预设函数（MOCK），可离线演示。
#
#  也可以写小写键名（api_key / url / model），效果相同。
# ============================================================

# 1) API Key —— 填了就进入联网模式
AI_API_KEY=sk-0813e75a7fda44cfbb6ba4d2999750b6

# 2) 接口地址 —— OpenAI 兼容的 /v1 根地址，不要带 /chat/completions
#    DeepSeek   https://api.deepseek.com
#    OpenAI     https://api.openai.com/v1
#    通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1
#    本地 vLLM  http://127.0.0.1:8000/v1
AI_BASE_URL=https://api.deepseek.com

# 3) 模型名 —— 留空则按地址推断（DeepSeek → deepseek-chat，其它 → gpt-4o-mini）
AI_MODEL=

# ---------------- 以下可选 ----------------
# 右上角徽标显示的名称，默认按域名推断（DeepSeek / OpenAI / 通义千问 …）
# AI_PROVIDER_NAME=
# 单次请求超时（毫秒）
# AI_TIMEOUT_MS=90000
# 采样温度
# AI_TEMPERATURE=0.2
# 设为 1 可强制回退本地预设函数（调试用）
# AI_MOCK=0
